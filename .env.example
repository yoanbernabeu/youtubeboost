# Copy this file to .env.local and fill it in. It is read by every container and
# is never committed.
#
#   cp .env.example .env.local
#
# Compose reads this file when it CREATES a container: after editing it,
# `docker compose restart` changes nothing. Recreate instead:
#
#   docker compose -f compose.yaml -f compose.prod.yaml stop
#   docker compose -f compose.yaml -f compose.prod.yaml up -d --force-recreate --wait

###> Application ###
APP_ENV=prod

# The single password protecting this instance. Choose a long one.
APP_PASSWORD=change-me

# Random string. It encrypts the Google refresh token in the database, so do not
# change it after connecting the channel: you would have to reconnect it.
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me

# Hostname served by FrankenPHP. "localhost" yields a self-signed certificate.
SERVER_NAME=localhost
DEFAULT_URI=https://localhost
###< Application ###

###> Database ###
# Keep the password identical in both lines.
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://app:change-me@database:5432/app?serverVersion=16&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock
###< Database ###

###> Google ###
# OAuth client of type "web application", from console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorised redirect URI character for character.
GOOGLE_REDIRECT_URI=https://localhost/oauth/callback

# Key from aistudio.google.com. Image generation requires billing to be enabled.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
###< Google ###

###> Tuning ###
# Milliseconds between two YouTube Analytics requests during a synchronisation.
ANALYTICS_REQUEST_DELAY_MS=250
###< Tuning ###
